# Copy to `.env` and fill in the values. Variables marked (required) must be set
# or the server aborts at startup; the rest fall back to the defaults shown.

# --- GitHub webhook ---
GITHUB_WEBHOOK_SECRET=your-webhook-secret   # (required) HMAC secret for X-Hub-Signature-256
WEBHOOK_DEDUPE_TTL_MS=600000                 # delivery-id dedupe window (10 min)
BODY_LIMIT_BYTES=26214400                    # max webhook body (25 MB, GitHub's cap)

# --- Devin API ---
# Both DEVIN_API_KEY and DEVIN_ORG_ID are needed to create sessions. Without
# them the webhook still runs and records dispatch failures on the dashboard.
DEVIN_API_KEY=your-devin-api-key
DEVIN_ORG_ID=your-devin-org-id
DEVIN_API_BASE_URL=https://api.devin.ai/v3
DEVIN_MAX_ACU_LIMIT=10
DEVIN_MAX_RETRIES=3
DEVIN_RETRY_INITIAL_DELAY_MS=1000
DEVIN_REQUEST_TIMEOUT_MS=30000

# --- HTTP server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Persistence (observability) ---
DATABASE_URL=file:/app/data/orchestrator.sqlite
POLL_INTERVAL_MS=30000
