# Copy to `.env` and fill in the values. Variables marked (required) must be set
# or the server aborts at startup; the rest fall back to the defaults shown.
#
# Comments live on their own lines on purpose: not every `.env` reader strips a
# trailing `# ...` from a value, and a secret that silently carries its comment
# along makes the webhook signature check fail.

# --- GitHub webhook ---
# (required) HMAC secret for X-Hub-Signature-256; use the same value in the
# GitHub webhook settings and in the curl simulation from the README.
GITHUB_WEBHOOK_SECRET=your-webhook-secret
# Delivery-id dedupe window (10 min).
WEBHOOK_DEDUPE_TTL_MS=600000
# Max webhook body (25 MB, GitHub's cap).
BODY_LIMIT_BYTES=26214400

# --- Devin API ---
# Both DEVIN_API_KEY and DEVIN_ORG_ID are needed to create sessions. Leave them
# empty to run without Devin: the webhook still works and deliveries are
# recorded as `dispatch_failed` on the dashboard. Filling them with placeholder
# values instead makes every dispatch and every poll fail against the real API
# with `403 Unauthorized`.
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_API_BASE_URL=https://api.devin.ai/v3
DEVIN_MAX_ACU_LIMIT=10
DEVIN_MAX_RETRIES=3
DEVIN_RETRY_INITIAL_DELAY_MS=1000
DEVIN_REQUEST_TIMEOUT_MS=30000

# --- HTTP server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Persistence (observability) ---
# Host default. Docker Compose overrides this with `file:/app/data/orchestrator.sqlite`,
# the path of the `orchestrator-data` volume, so leave it as a host path here.
DATABASE_URL=file:./data/orchestrator.sqlite
POLL_INTERVAL_MS=30000
# Blocked sessions with no structured output become needs_human_attention after this long.
BLOCKED_GRACE_MS=600000
