# --- Devin API ---
DEVIN_API_KEY=your-devin-api-key
DEVIN_ORG_ID=your-devin-org-id
DEVIN_API_BASE_URL=https://api.devin.ai/v3
DEVIN_MAX_ACU_LIMIT=10
DEVIN_MAX_RETRIES=3
DEVIN_RETRY_INITIAL_DELAY_MS=1000

# --- GitHub webhook ---
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_TOKEN=your-github-token
WEBHOOK_DEDUPE_TTL_MS=600000

# --- HTTP server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Persistence (observability) ---
DATABASE_URL=file:/app/data/orchestrator.sqlite
